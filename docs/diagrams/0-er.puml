@startuml
!include common.iuml
title ER diagram - appointment_scheduler (MySQL 8)
hide methods
entity "users" as users {
  * id : BIGINT <<PK>>
  --
  * first_name : VARCHAR(50)
  * last_name : VARCHAR(50)
  * email : VARCHAR(100) <<UNIQUE>>
  phone : VARCHAR(20)
  date_of_birth : DATE
  * password_hash : VARCHAR(100)
  * role : VARCHAR(20)  (PATIENT | ADMIN)
  * created_at : DATETIME(6)
}
entity "services" as services {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100) <<UNIQUE>>
  description : VARCHAR(255)
  * duration_minutes : INT
  * active : BOOLEAN
}
entity "time_slots" as slots {
  * id : BIGINT <<PK>>
  --
  * slot_date : DATE
  * start_time : TIME
  * end_time : TIME
  * available : BOOLEAN
  UNIQUE (slot_date, start_time)
}
entity "appointments" as appts {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  * service_id : BIGINT <<FK>>
  * slot_id : BIGINT <<FK, UNIQUE>>
  * status : VARCHAR(20)  (BOOKED | COMPLETED)
  notes : VARCHAR(255)
  * created_at : DATETIME(6)
  updated_at : DATETIME(6)
}
users ||--o{ appts : books
services ||--o{ appts : "visit type"
slots ||--o| appts : "holds at most one"
@enduml
